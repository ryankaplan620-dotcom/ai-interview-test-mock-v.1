# ==================================================
# Folio — Environment Variables
# Copy to .env.local for development
# See FOLIO-SETUP-PLAN.md for how to obtain each value
# ==================================================

# Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ==================================================
# Supabase (required for auth + database)
# ==================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==================================================
# Stripe (required for billing)
# ==================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs — see FOLIO-SETUP-PLAN.md Phase 3.5
STRIPE_PRICE_STUDENT_MONTHLY=
STRIPE_PRICE_STUDENT_YEARLY=
STRIPE_PRICE_GENERAL_MONTHLY=
STRIPE_PRICE_GENERAL_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
STRIPE_PRICE_COACH_REVIEW=

# ==================================================
# Student verification
# "sheerid" for production, "edu_email" for launch-day fallback
# ==================================================
STUDENT_VERIFICATION_MODE=edu_email
SHEERID_API_KEY=
SHEERID_STUDENT_PROGRAM_ID=

# ==================================================
# Resend (email)
# ==================================================
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=noreply@folio.io
RESEND_FROM_NAME=Folio
WAITLIST_NOTIFY_EMAIL=hello@folio.io

# ==================================================
# Phase 2 — voice pipeline
# ==================================================
# ANTHROPIC_API_KEY=
# SIMLI_API_KEY=
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=
