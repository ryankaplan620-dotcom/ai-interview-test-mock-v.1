# ==================================================
# Folio — Environment Variables
# Copy to .env.local for development
# See FOLIO-SETUP-PLAN.md for how to obtain each value
# ==================================================

# Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ==================================================
# Supabase (required for auth + database)
# ==================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==================================================
# Stripe (required for billing)
# ==================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs — Phase H single-cycle pricing per tier.
# Cycle = $49 / 90 days (students), Pro = $149 / 365 days, Max = $249 / 365 days.
# Overage prices cover additional-session charges beyond the included count.
STRIPE_PRICE_CYCLE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_OVERAGE_STANDARD=
STRIPE_PRICE_OVERAGE_MAX=

# ==================================================
# Student verification
# "sheerid" for production, "edu_email" for launch-day fallback
# ==================================================
STUDENT_VERIFICATION_MODE=edu_email
SHEERID_API_KEY=
SHEERID_STUDENT_PROGRAM_ID=

# ==================================================
# Resend (email)
# ==================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@folio.io
RESEND_FROM_NAME=Folio

# ==================================================
# Phase 2 — Voice pipeline
# Any of these missing will fall back to mock-mode behaviour locally.
# See FOLIO-SETUP-PLAN.md Phase 3.2–3.4 for provisioning.
# ==================================================

# ---- Anthropic (persona intelligence) ----
ANTHROPIC_API_KEY=
# Models — sonnet for interview streaming (latency), sonnet for feedback (quality)
ANTHROPIC_MODEL_INTERVIEW=claude-sonnet-4-6
ANTHROPIC_MODEL_FEEDBACK=claude-sonnet-4-6

# ---- Tavus (avatar WebRTC) ----
TAVUS_API_KEY=
TAVUS_REPLICA_ID_PRIYA=
TAVUS_REPLICA_ID_MARCUS=
TAVUS_REPLICA_ID_SARAH=
TAVUS_REPLICA_ID_DAVID=
TAVUS_REPLICA_ID_JENNIFER=
# Webhook shared secret. Embedded in the callback URL path Tavus posts to
# (Tavus doesn't support custom headers, so URL-path is the standard pattern).
# Generate with: openssl rand -hex 32
# MUST be set in production — the conversation-create route returns 503 if
# it's missing. Rotate by changing this value; only affects new conversations.
TAVUS_WEBHOOK_SECRET=

# ---- ElevenLabs (voice synthesis) ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID_PRIYA=
ELEVENLABS_VOICE_ID_MARCUS=
ELEVENLABS_VOICE_ID_SARAH=
ELEVENLABS_VOICE_ID_DAVID=
ELEVENLABS_VOICE_ID_JENNIFER=

# ---- Deepgram (speech-to-text) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- Cloudflare R2 (recordings + transcripts) ----
# S3-compatible. Create a bucket, plus an access key pair with R/W on it.
# R2_PUBLIC_URL is the public/CDN bucket URL if you serve recordings directly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=folio-sessions
R2_PUBLIC_URL=

# ---- Dev toggles ----
# Set to "true" to force mock mode on all voice pipeline clients regardless of keys.
# Useful for UI development without burning API credit.
FOLIO_FORCE_MOCK_PIPELINE=false

# ==================================================
# Rate limiting (Phase Rate-Limit)
# Upstash Redis REST — used for per-user rate limiting of the two expensive
# endpoints: /api/tavus/conversation and /api/feedback/generate.
#
# Get these from https://console.upstash.com/redis — create a new Redis
# database (global/regional both fine), then copy the REST URL + token from
# the "REST API" tab.
#
# If these are unset, rate limiting is disabled and all requests pass through
# with a log warning. Safe for local dev; DO NOT leave unset in production.
# ==================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
